{
  "manifest_version": 3,
  "name": "LUMO Browser Companion",
  "version": "0.1.0",
  "description": "Save web pages, selected text, notes, and tags to your private local LUMO Personal Workspace.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to LUMO Workspace",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "lumo-companion@lumo.local",
      "strict_min_version": "109.0"
    }
  }
}
