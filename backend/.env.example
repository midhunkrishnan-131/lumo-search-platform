# Copy this file to .env and configure your local environment.
# Never commit .env. Do not put real passwords or API keys in this example.

APP_NAME=LUMO
APP_VERSION=0.1.0
ENVIRONMENT=development
# For PostgreSQL: postgresql+psycopg://lumo_user:change-me@127.0.0.1:5432/lumo
# For zero-setup local SQLite: sqlite:///lumo.db
DATABASE_URL=sqlite:///lumo.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# Crawler Configuration (Phase 3)
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES=100
CRAWLER_CONCURRENCY=2
CRAWLER_PER_DOMAIN_CONCURRENCY=1
CRAWLER_CRAWL_DELAY=1.0

# Semantic & Hybrid Search Configuration (Phases 6-7)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=lumo_documents
QDRANT_STORAGE_PATH=./qdrant_storage
HYBRID_RRF_K=60

# AI Search & RAG Providers (Phase 8)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROK_API_KEY=
GROK_MODEL=grok-beta

AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

AI_REQUEST_TIMEOUT=30.0
AI_MAX_CONTEXT_DOCUMENTS=8
AI_MAX_CONTEXT_TOKENS=4000

# Autonomous Research Agent Configuration (Phase 9)
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_QUERIES=12
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_DURATION_SECONDS=120.0
RESEARCH_MAX_AI_CALLS=10

# Download Guardian Configuration (Phase 10)
GUARDIAN_MAX_FILE_SIZE_BYTES=26214400
GUARDIAN_MAX_REDIRECTS=5
GUARDIAN_REQUEST_TIMEOUT=5.0
GUARDIAN_VIRUSTOTAL_API_KEY=

# Optional API token for non-localhost/LAN deployments (leave blank for local single-user mode)
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=240
